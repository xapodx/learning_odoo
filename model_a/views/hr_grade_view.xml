<odoo>
    <record id="hr_grade_view_tree" model="ir.ui.view">
        <field name="name">hr.grade Tree</field>
        <field name="model">hr.grade</field>
        <field name="arch" type="xml">
            <tree multi_edit="1" class="header_custom">
                <field name="name"/>
                <field name="allowance_housing"/>
                <field name="allowance_transport"/>
                <field name="allowance_medical"/>
                <field name="allowance_food"/>
                <field name="bonus_percentage"/>
                <field name="total_allowances"/>
                <field name="state"/>
            </tree>
        </field>
    </record>
    
    <record id="hr_grade_view_search" model="ir.ui.view">
        <field name="name">hr.grade search</field>
        <field name="model">hr.grade</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="state"/>
                <filter name="draft" string="Draft" domain="[('state', '=', 'draft')]"/>
                <filter name="pending" string="Pending" domain="[('state', '=', 'pending')]"/>
                <filter name="approved" string="Approved" domain="[('state', '=', 'approved')]"/>
            </search>
        </field>
    </record>
    
    <record id="hr_grade_view_form" model="ir.ui.view">
        <field name="name">hr.grade Form</field>
        <field name="model">hr.grade</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <header>
                        <button name="action_draft" type="object" class="btn-primary" string="Set To Draft"
                                invisible="state == 'draft'"/>
                        <button name="action_pending" type="object" class="btn-secondary" string="Set To Pending"
                                invisible="state != 'draft' "/>
                        <button name="action_approved" type="object" class="btn-success" string="Set To Approved"
                                invisible="state !='pending' "/>
                        <field name="state" widget="statusbar"/>
                    </header>

                    <group>
                        <group>
                            <field name="name"/>
                            <field name="state"/>
                            <field name="total_allowances"/>
                        </group>
                        <group>
                            <field name="allowance_housing"/>
                            <field name="allowance_transport"/>
                            <field name="allowance_medical"/>
                            <field name="allowance_food"/>
                            <field name="bonus_percentage"/>
                            <field name="allowance_shift"/>
                        </group>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids" widget="mail_followers"/>
                    <field name="message_ids" widget="mail_thread"/>
                </div>
            </form>
        </field>
    </record>
    
    <record id="hr_grade_action" model="ir.actions.act_window">
        <field name="name">Employee Grades</field>
        <field name="res_model">hr.grade</field>
    </record>

    <menuitem
        id="hr_grade_menu_item"
        name="Employee Grades"
        parent="properties_menu"
        action="hr_grade_action"
    />
</odoo>